with "config/gpr_to_source_dirs_config.gpr";
project Gpr_To_Source_Dirs is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Gpr_To_Source_Dirs_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("gpr_to_source_dirs.adb", "gpr_with_extract.adb");

   package Compiler is
      for Default_Switches ("Ada") use Gpr_To_Source_Dirs_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Gpr_To_Source_Dirs;
