:7367, properties:{is_part_of_inherited:false, element_kind:"A_DEFINITION", enclosing_unit:"Interfaces.C", is_part_of_instance:false, kinds:["Element", "A_DEFINITION", "A_TYPE_DEFINITION", "A_SIGNED_INTEGER_TYPE_DEFINITION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"range -(2 ** (System.Parameters.ptr_bits - Integer'(1))) ..\n           +(2 ** (System.Parameters.ptr_bits - Integer'(1)) - 1)"}}, {_id:5983, properties:{is_part_of_inherited:false, element_kind:"A_DEFINITION", enclosing_unit:"Interfaces", is_part_of_instance:false, kinds:["Element", "A_DEFINITION", "A_TYPE_DEFINITION", "A_SIGNED_INTEGER_TYPE_DEFINITION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"range -2 **  7 .. 2 **  7 - 1"}}, {_id:6031, properties:{is_part_of_inherited:false, element_kind:"A_DEFINITION", enclosing_unit:"Interfaces", is_part_of_instance:false, kinds:["Element", "A_DEFINITION", "A_TYPE_DEFINITION", "A_SIGNED_INTEGER_TYPE_DEFINITION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"range -2 ** 15 .. 2 ** 15 - 1"}}, {_id:6079, properties:{is_part_of_inherited:false, element_kind:"A_DEFINITION", enclosing_unit:"Interfaces", is_part_of_instance:false, kinds:["Element", "A_DEFINITION", "A_TYPE_DEFINITION", "A_SIGNED_INTEGER_TYPE_DEFINITION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"range -2 ** 31 .. 2 ** 31 - 1"}}, {_id:17968, properties:{is_part_of_inherited:false, element_kind:"A_DEFINITION", enclosing_unit:"T_Usage", is_part_of_instance:false, kinds:["Element", "A_DEFINITION", "A_TYPE_DEFINITION", "A_SIGNED_INTEGER_TYPE_DEFINITION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"range 1 .. 10"}}, {_id:14486, properties:{is_part_of_inherited:false, element_kind:"A_DEFINITION", enclosing_unit:"System.Tasking", is_part_of_instance:false, kinds:["Element", "A_DEFINITION", "A_TYPE_DEFINITION", "A_SIGNED_INTEGER_TYPE_DEFINITION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"range Interrupt_Entry .. Max_Entry"}}]
