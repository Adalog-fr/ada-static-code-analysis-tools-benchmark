", enclosing_unit:"System.Stack_Usage", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"__gnat_stack_usage_output_results\""}}, {_id:1929, properties:{is_part_of_inherited:false, element_kind:"AN_EXPRESSION", enclosing_unit:"System.Parameters", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"__gnat_malloc\""}}, {_id:11057, properties:{is_part_of_inherited:false, element_kind:"AN_EXPRESSION", enclosing_unit:"System.OS_Interface", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"sigismember\""}}, {_id:11082, properties:{is_part_of_inherited:false, element_kind:"AN_EXPRESSION", enclosing_unit:"System.OS_Interface", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"sigemptyset\""}}, {_id:7054, properties:{is_part_of_inherited:false, element_kind:"AN_EXPRESSION", enclosing_unit:"System.Stack_Usage", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"__gnat_stack_usage_results\""}}, {_id:1000, properties:{is_part_of_inherited:false, element_kind:"AN_EXPRESSION", enclosing_unit:"Ada.Calendar", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"__gnat_split\""}}, {_id:2194, properties:{is_part_of_inherited:false, element_kind:"AN_EXPRESSION", enclosing_unit:"System.Standard_Library", is_part_of_instance:false, kinds:["Element", "AN_EXPRESSION", "A_STRING_LITERAL"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"\"CONSTRAINT