_Ptr : SST.SS_Stack_Ptr;\n      --  Pointer of the allocated secondary stack\n\n      Current_Excep : aliased EO;\n      --  Exception occurrence that contains the information for the current\n      --  exception. Note that any exception in the same task destroys this\n      --  information, so the data in this variable must be copied out before\n      --  another exception can occur.\n      --\n      --  Also act as a list of the active exceptions in the case of the GCC\n      --  exception mechanism, organized as a stack with the most recent first.\n   end record;"}}, {_id:12655, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.OS_Interface", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "AN_ORDINARY_TYPE_DECLARATION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"type struct_sched_param is record\n      sched_priority : int;  --  scheduling priority\n   end record;"}}, {_id:8708, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.OS_Constants", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "AN_ORDINARY_TYPE_DECLARATION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"type OS_Type is (Windows, Other_OS);"}}, {_id:5789, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.Soft_Links", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "AN_ORDINARY_TYPE_DECLARATION"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"type Dummy_Communication_Block is record\n      Comp_1 : Address;  --  Address and access have the same size\n      Comp_2 : Boolean;\n      Comp_3 : Boolean;\n   end record;"}}, {_id:5893, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.Address_To_Access_Conversions", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "AN_ORDINARY_TYPE_DECLARATION"], is_part_of