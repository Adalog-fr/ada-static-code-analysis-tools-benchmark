served : constant Signal_Set := (\n      SIG32, SIG33, SIG34\n      --  glibc POSIX threads implementation uses two (NPTL) or three\n      --  (LinuxThreads) real-time signals for its own use (see SIGNAL(7)).\n      --  These signals are considered reserved and not unmasked as glibc does\n      --  not permit these signals to be used by the public signal.h API.\n      --  While LinuxThreads is mostly likely unused now, SIG34 is still\n      --  reserved as this behavior is consistent with past GNAT releases.\n      );"}}, {_id:1819, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.Parameters", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "A_CONSTANT_DECLARATION", "AN_ORDINARY_TRAIT"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"Unspecified_Size : constant Size_Type := Size_Type'First;"}}, {_id:1853, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.Parameters", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "A_CONSTANT_DECLARATION", "AN_ORDINARY_TRAIT"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"Default_Env_Stack_Size : constant Size_Type := 8_192_000;"}}, {_id:1861, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.Parameters", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "A_CONSTANT_DECLARATION", "AN_ORDINARY_TRAIT"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"Stack_Grows_Down  : constant Boolean := True;"}}, {_id:1869, properties:{is_part_of_inherited:false, element_kind:"A_DECLARATION", enclosing_unit:"System.Parameters", is_part_of_instance:false, kinds:["Element", "A_DECLARATION", "A_CONSTANT_DECLARATION", "AN_ORDINARY_TRAIT"], is_part_of_implicit:false, special_case:"NOT_A_SPECIAL_CASE", content:"Runtime_Default_Sec_Stack_Size : constant Size_Type := 10 * 1024;"}}, {_id:1885, properties:{is_part_of_in