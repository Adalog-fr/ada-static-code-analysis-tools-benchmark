--
--  The ZanyBlue.Text.Codecs supports string encoding and decoding for
--  various encoding schemes, e.g., UTF-8, etc.
--

with Ada.Wide_Wide_Characters.Handling;
with Ada.Characters.Conversions;

package body ZanyBlue.Text.Codecs is

   type Encoder_Type is
      access function (Encoding_Index : Positive;
                       Value          : String) return String;

   type Decoder_Type is
      access function (Encoding_Index : Positive;
                       Value          : String) return String;

   subtype Code_Point_Type is Natural range 0 .. 16#FFFF#;
   type Encoding_Map_Type is
      record
         Code_Point  : Code_Point_Type;
         C1          : Character;
         C2          : Character;
         Need_Second : Boolean;
      end record;

   type Decoding_Consume_Type is (Next, Finished);
   type Decoding_Map_Type is
      record
         Ch                : Character;
         Decoding_Consume  : Decoding_Consume_Type;
         WCh               : Unicode_Character;
         Next_Start        : Natural;
         Next_Finish       : Natural;
      end record;

   type String_Access is access String;
   type Handler_Type is
      record
         Index         : Positive;
         Encoding      : String_Access;
         Encoder       : Encoder_Type;
         Decoder       : Decoder_Type;
         Encode_Start  : Natural;
         Encode_Finish : Natural;
         Decode_Start  : Natural;
         Decode_Finish : Natural;
      end record;

   Unsupported_Encoding_Action : Unsupported_Encoding_Action_Type := Use_UTF8;
   Unicode_Encode_Action : Unicode_XForm_Action_Type := Replace;
   Unicode_Decode_Action : Unicode_XForm_Action_Type := Replace;
   Replacement_Character : constant Unicode_Character := '?';

   Default_Codecs_Index_Value : Positive := 1;

   function Decode_ASCII (Encoding_Index : Positive;
                          Value          : String) return String;
   function Encode_ASCII (Encoding_Index : Positive;
                          Value          : String) return String;

   function Decode_ISO8859_1 (Encoding_Index : Positive;
                              Value          : String) return String;
   function Encode_ISO8859_1 (Encoding_Index : Positive;
                              Value          : String) return String;

   function Decode_Lookup (Encoding_Index : Positive;
                           Value          : String) return String;
   function Encode_Lookup (Encoding_Index : Positive;
                           Value          : String) return String;

   function Decode_UTF8 (Encoding_Index : Positive;
                         Value          : String) return String;
   function Encode_UTF8 (Encoding_Index : Positive;
                         Value       : String) return String;

   procedure Handle_Unicode_Decode_Error (Encoding_Index : Positive;
                                          Code_Point     : Natural);

   procedure Handle_Unicode_Encode_Error (Encoding_Index : Positive;
                                          Code_Point     : Natural);

   function Find_Codecs (Encoding     : String;
                         Always_Raise : Boolean := False) return Positive;

   function Normalize_Name (Encoding : String) return String;

   EA : constant Encoder_Type := Encode_ASCII'Access;
   DA : constant Decoder_Type := Decode_ASCII'Access;
   EI : constant Encoder_Type := Encode_ISO8859_1'Access;
   DI : constant Decoder_Type := Decode_ISO8859_1'Access;
   EL : constant Encoder_Type := Encode_Lookup'Access;
   DL : constant Decoder_Type := Decode_Lookup'Access;
   EU : constant Encoder_Type := Encode_UTF8'Access;
   DU : constant Decoder_Type := Decode_UTF8'Access;

