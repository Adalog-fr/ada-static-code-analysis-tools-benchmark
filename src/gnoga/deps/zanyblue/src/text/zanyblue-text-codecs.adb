      (41, new String'("ISO88595"), EL, DL, 64974, 65229, 65764, 66019),
      (42, new String'("ISO88596"), EL, DL, 65230, 65440, 66020, 66230),
      (43, new String'("ISO88597"), EL, DL, 65441, 65693, 66231, 66483),
      (44, new String'("ISO88598"), EL, DL, 65694, 65913, 66484, 66703),
      (45, new String'("ISO88599"), EL, DL, 65914, 66169, 66704, 66959),
      (46, new String'("SHIFTJIS"), EL, DL, 2451, 9967, 10175, 10410),
      (47, new String'("UTF8"), EU, DU, 0, 0, 0, 0)
   );

   --  End of embedded codecs data

   ------------
   -- Decode --
   ------------

   function Decode (Encoding : String;
                    Value : String) return String is
   begin
      return Decode (Make_Codecs (Encoding), Value);
   end Decode;

   ------------
   -- Decode --
   ------------

   function Decode (Codecs : Codecs_Type;
                    Value : String) return String is
      Encoding_Index : constant Positive := Codecs.Encoding_Index;
   begin
      return Handlers (Encoding_Index).Decoder (Encoding_Index, Value);
   end Decode;

   ------------------
   -- Decode_ASCII --
   ------------------

   function Decode_ASCII (Encoding_Index : Positive;
                          Value          : String) return String is
   begin
      return Result : String :=  Value do
         for I in Result loop
            declare
               Ch : constant Unicode_Character := Value (Value.First + I - 1);
               Code_Point : constant Natural := Unicode_Character'Pos (Ch);
            begin
               if Code_Point > 16#7F# then
                  Handle_Unicode_Decode_Error (Encoding_Index, Code_Point);
               end if;
               Result.Replace_Unicode (I, Unicode_Character'Val (Code_Point));
            end;
         end loop;
      end return;
   end Decode_ASCII;

   ----------------------
   -- Decode_ISO8859_1 --
   ----------------------

   function Decode_ISO8859_1 (Encoding_Index : Positive;
                              Value          : String) return String is
      pragma Unreferenced (Encoding_Index);
   begin
      return Result : String := Value do
         for I in Result loop
            declare
               Ch : constant Unicode_Character := Value (Value.First + I - 1);
               Code_Point : constant Natural := Unicode_Character'Pos (Ch);
            begin
               Result.Replace_Unicode (I, Unicode_Character'Val (Code_Point));
            end;
         end loop;
      end return;
   end Decode_ISO8859_1;

   -------------------
   -- Decode_Lookup --
   -------------------

   function Decode_Lookup (Encoding_Index : Positive;
                           Value          : String) return String is

      Buffer : String;
      Start : constant Positive := Handlers (Encoding_Index).Decode_Start;
      Finish : constant Positive := Handlers (Encoding_Index).Decode_Finish;
      Cur_Start : Positive := Start;
      Cur_Finish : Positive := Finish;
      Decode_Map : Decoding_Map_Type;

      function Find_Decode_Map (Ch     : Character;
                                Start  : Positive;
                                Finish : Positive) return Decoding_Map_Type;

      ---------------------
      -- Find_Decode_Map --
      ---------------------

      function Find_Decode_Map (Ch     : Character;
                                Start  : Positive;
                                Finish : Positive) return Decoding_Map_Type is

         Min : Positive := Start;
         Max : Positive := Finish;
         Mid : Positive;

      begin
         while Min <= Max loop
            Mid := (Min + Max) / 2;
            if Decoding_Data (Mid).Ch = Ch then
               return Decoding_Data (Mid);
            elsif Decoding_Data (Mid).Ch < Ch then
               Min := Mid + 1;
            else
               Max := Mid - 1;
            end if;
         end loop;
         Handle_Unicode_Decode_Error (Encoding_Index, Character'Pos (Ch));
         return Decoding_Map_Type'(
              Ch => Ch,
              Decoding_Consume => Finished,
              WCh => '?',
              Next_Start => 0,
              Next_Finish => 0);
      end Find_Decode_Map;

   begin
      for Index in Value loop
         Decode_Map := Find_Decode_Map
           (Value.To_Latin_1 (Index), Cur_Start, Cur_Finish);
         case Decode_Map.Decoding_Consume is
         when Next =>
            Cur_Start := Decode_Map.Next_Start;
            Cur_Finish := Decode_Map.Next_Finish;
         when Finished =>
            Append (Buffer, Decode_Map.WCh);
            Cur_Start := Start;
            Cur_Finish := Finish;
         end case;
      end loop;
      if Decode_Map.Decoding_Consume = Next then
         Handle_Unicode_Decode_Error (Encoding_Index,
            Character'Pos (Value.To_Latin_1 (Value.Last)));
      end if;
      return Buffer;
   end Decode_Lookup;

   -----------------
   -- Decode_UTF8 --
   -----------------

   function Decode_UTF8 (Encoding_Index : Positive;
                         Value          : String) return String is
      pragma Unreferenced (Encoding_Index);
   begin
      return Value;
   end Decode_UTF8;

