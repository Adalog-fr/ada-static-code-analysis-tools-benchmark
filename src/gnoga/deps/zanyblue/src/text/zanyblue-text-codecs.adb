   --------------------
   -- Normalize_Name --
   --------------------

   function Normalize_Name (Encoding : String) return String is

      use Ada.Wide_Wide_Characters.Handling;

      Result : String;
      Cur : Natural := 0;

   begin
      for I in Encoding loop
         if Is_Alphanumeric (Encoding (I)) then
            Cur := Cur + 1;
            Append (Result, To_Upper (Encoding (I)));
         end if;
      end loop;
      return Result;
   end Normalize_Name;

