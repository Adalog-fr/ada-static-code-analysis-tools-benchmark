   ------------
   -- Encode --
   ------------

   function Encode (Codecs : Codecs_Type;
                    Value : String) return String is
      Encoding_Index : constant Positive := Codecs.Encoding_Index;
   begin
      return Handlers (Encoding_Index).Encoder (Encoding_Index, Value);
   end Encode;

   ------------------
   -- Encode_ASCII --
   ------------------

   function Encode_ASCII (Encoding_Index : Positive;
                          Value          : String) return String is
   begin
      return Result : String := Value do
         for I in Result loop
            declare
               WCh : constant Unicode_Character := Value (Value.First + I - 1);
               Wide_Code_Point : constant Natural :=
                 Unicode_Character'Pos (WCh);
               Overflow : constant Boolean := Wide_Code_Point > 128;
               Code_Point : constant Natural := Wide_Code_Point mod 128;
            begin
               if Overflow then
                  Handle_Unicode_Encode_Error (Encoding_Index, Code_Point);
                  Result.Replace_Unicode (I, Replacement_Character);
               else
                  Result.Replace_Unicode
                    (I, Unicode_Character'Val (Code_Point));
               end if;
            end;
         end loop;
      end return;
   end Encode_ASCII;

   ----------------------
   -- Encode_ISO8859_1 --
   ----------------------

   function Encode_ISO8859_1 (Encoding_Index : Positive;
                              Value          : String) return String is
   begin
      return Result : String := Value do
         for I in Result loop
            declare
               WCh : constant Unicode_Character := Value (Value.First + I - 1);
               Wide_Code_Point : constant Natural :=
                 Unicode_Character'Pos (WCh);
               Overflow : constant Boolean := Wide_Code_Point > 255;
               Code_Point : constant Natural := Wide_Code_Point mod 256;
            begin
               if Overflow then
                  Handle_Unicode_Encode_Error (Encoding_Index, Code_Point);
                  Result.Replace_Unicode (I, Replacement_Character);
               else
                  Result.Replace_Unicode
                    (I, Unicode_Character'Val (Code_Point));
               end if;
            end;
         end loop;
      end return;
   end Encode_ISO8859_1;

   -------------------
   -- Encode_Lookup --
   -------------------

   function Encode_Lookup (Encoding_Index : Positive;
                           Value          : String) return String is

      Buffer : String;
      Start : constant Positive := Handlers (Encoding_Index).Encode_Start;
      Finish : constant Positive := Handlers (Encoding_Index).Encode_Finish;

      procedure Encode_Character (Code_Point : Natural);

      procedure Encode_Character (Code_Point : Natural) is

         Min : Positive := Start;
         Max : Positive := Finish;
         Mid : Positive;

         use Ada.Characters.Conversions;

      begin
         while Min <= Max loop
            Mid := (Min + Max) / 2;
            if Encoding_Data (Mid).Code_Point = Code_Point then
               Append (Buffer, To_Wide_Wide_Character
                       (Encoding_Data (Mid).C1));
               if Encoding_Data (Mid).Need_Second then
                  Append (Buffer, To_Wide_Wide_Character
                          (Encoding_Data (Mid).C2));
               end if;
               return;
            elsif Encoding_Data (Mid).Code_Point < Code_Point then
               Min := Mid + 1;
            else
               Max := Mid - 1;
            end if;
         end loop;
         Handle_Unicode_Encode_Error (Encoding_Index, Code_Point);
         Append (Buffer, Replacement_Character);
      end Encode_Character;

   begin
      for I in Value loop
         Encode_Character (Unicode_Character'Pos (Value (I)));
      end loop;
      return Buffer;
   end Encode_Lookup;

   -----------------
   -- Encode_UTF8 --
   -----------------

   function Encode_UTF8 (Encoding_Index : Positive;
                         Value          : String) return String is
      pragma Unreferenced (Encoding_Index);
   begin
      return Value;
   end Encode_UTF8;

   -----------------
   -- Find_Codecs --
   -----------------

   function Find_Codecs (Encoding     : String;
                         Always_Raise : Boolean := False) return Positive is

      UC_Encoding : constant String := Normalize_Name (Encoding);
      Min : Integer := Handlers'First;
      Max : Integer := Handlers'Last;
      Mid : Integer;

   begin
      while Min <= Max loop
         Mid := (Min + Max) / 2;
         if Handlers (Mid).Encoding.all = UC_Encoding then
            return Mid;
         elsif Handlers (Mid).Encoding.all < UC_Encoding then
            Min := Mid + 1;
         else
            Max := Mid - 1;
         end if;
      end loop;
      if Always_Raise or Unsupported_Encoding_Action = Raise_Exception then
         raise Unsupported_Encoding with
             "Unsupported encoding '"
            & To_UTF_8 (Encoding) & "'";
      end if;
      return Default_Codecs_Index_Value;
   end Find_Codecs;

   ---------------------------------
   -- Handle_Unicode_Decode_Error --
   ---------------------------------

   procedure Handle_Unicode_Decode_Error (Encoding_Index : Positive;
                                          Code_Point     : Natural) is
   begin
      if Unicode_Decode_Action = Raise_Exception then
         raise Unicode_Decode_Error
            with "'" & To_UTF_8 (Name (Encoding_Index))
               & "' codecs cannot decode character #"
               & Natural'Image (Code_Point);
      end if;
   end Handle_Unicode_Decode_Error;

   ---------------------------------
   -- Handle_Unicode_Encode_Error --
   ---------------------------------

   procedure Handle_Unicode_Encode_Error (Encoding_Index : Positive;
                                          Code_Point     : Natural) is
   begin
      if Unicode_Encode_Action = Raise_Exception then
         raise Unicode_Encode_Error
            with "'" & To_UTF_8 (Name (Encoding_Index))
               & "' codecs cannot encode character #"
               & Natural'Image (Code_Point);
      end if;
   end Handle_Unicode_Encode_Error;

   --------------------
   -- Implementation --
   --------------------

   function Implementation (Codecs : Codecs_Type) return Implementation_Type is

      Encoding_Index : constant Positive := Codecs.Encoding_Index;
      Codecs_Data : constant Handler_Type := Handlers (Encoding_Index);

   begin
      if Codecs_Data.Encoder = EL or Codecs_Data.Decoder = DL then
         return Data_Driven;
      else
         return Internal;
      end if;
   end Implementation;

   -----------------------
   -- Iterate_Decodings --
   -----------------------

   procedure Iterate_Decodings (
      Codecs   : Codecs_Type;
      Handler : not null access procedure (WCh : Unicode_Character;
                                           Encoding : String)) is

      procedure Helper (Start : Natural;
                        Finish : Natural;
                        Prefix : String := "");

      ------------
      -- Helper --
      ------------

      procedure Helper (Start  : Natural;
                        Finish : Natural;
                        Prefix : String := "") is
      begin
         for Index in Start .. Finish loop
            case Decoding_Data (Index).Decoding_Consume is
            when Next =>
               Helper (Decoding_Data (Index).Next_Start,
                       Decoding_Data (Index).Next_Finish,
                       Prefix & From_Latin_1 (Decoding_Data (Index).Ch));
            when Finished =>
               Handler (Decoding_Data (Index).WCh,
                        Prefix & From_Latin_1 (Decoding_Data (Index).Ch));
            end case;
         end loop;
      end Helper;

      Encoding_Index : constant Positive := Codecs.Encoding_Index;
      Codecs_Data : constant Handler_Type := Handlers (Encoding_Index);

   begin
      Helper (Codecs_Data.Decode_Start, Codecs_Data.Decode_Finish);
   end Iterate_Decodings;

   -----------------------
   -- Iterate_Encodings --
   -----------------------

   procedure Iterate_Encodings (
      Codecs   : Codecs_Type;
      Handler : not null access procedure (WCh : Unicode_Character;
                                           Encoding : String)) is

      Encoding_Index : constant Positive := Codecs.Encoding_Index;
      Codecs_Data : constant Handler_Type := Handlers (Encoding_Index);

   begin
      for Index in Codecs_Data.Encode_Start .. Codecs_Data.Encode_Finish loop
         if Encoding_Data (Index).Need_Second then
            Handler (Unicode_Character'Val (Encoding_Data (Index).Code_Point),
                     From_Latin_1 (Encoding_Data (Index).C1 &
                         Encoding_Data (Index).C2));
         else
            Handler (Unicode_Character'Val (Encoding_Data (Index).Code_Point),
                     From_Latin_1 (Encoding_Data (Index).C1));
         end if;
      end loop;
   end Iterate_Encodings;

   -----------------
   -- Make_Codecs --
   -----------------

   function Make_Codecs (Encoding : String) return Codecs_Type is
   begin
      return Codecs_Type'(Encoding_Index => Find_Codecs (Encoding));
   end Make_Codecs;

